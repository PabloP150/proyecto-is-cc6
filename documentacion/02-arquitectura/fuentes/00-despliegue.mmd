---
config:
  architecture:
    idealEdgeLengthMultiplier: 2
---
architecture-beta
    group dev(mdi:laptop)[macOS o Linux]
    service smeec(logos:npm-icon)[smee-client] in dev
    service tun(mdi:tunnel-outline)[Túnel localtunnel o cloudflared] in dev
    junction jl in dev
    junction jv in dev
    junction jb in dev
    service cra(logos:react)[CRA npm start puerto 3000] in dev
    service api(logos:nodejs-icon)[API node puerto 9000] in dev
    junction ja in dev
    junction jx in dev
    junction jd in dev
    group pyg(logos:python)[Servicio Python del chat] in dev
    service py(logos:fastapi-icon)[uvicorn 127.0.0.1 puerto 8001] in pyg
    junction jm in dev
    group ctr(logos:docker-icon)[Contenedores] in dev
    service db(mdi:database)[taskmate-sql SQL Server 2019 puerto 1433] in ctr
    service pg(logos:postgresql)[taskmate-ai-db Postgres y pgvector puerto 5432] in ctr
    group ial(logos:linux-tux)[IA local en Linux] in dev
    service aisrv(logos:fastapi-icon)[Servidor de IA local 127.0.0.1 puerto 8000] in ial
    service ollama(logos:ollama)[Ollama 127.0.0.1 puerto 11434] in ial

    group github(logos:github-icon)[GitHub]
    service gh(logos:github-icon)[API de GitHub] in github
    service runners(logos:github-actions)[Runners ubuntu-latest] in github
    service pages(mdi:web)[GitHub Pages] in github

    service smeeio(cloud)[smee.io]
    service vercel(logos:vercel-icon)[Vercel]
    service browser(mdi:web)[Navegador local o de otro equipo de la red]
    service groq(logos:groq)[Groq]

    gh:L --> R:smeeio
    smeeio:L --> T:smeec
    smeec:R -- L:jl
    vercel:R --> L:tun
    tun:R -- L:jv
    jv:T -- B:jl
    jb:T -- B:jv
    browser:T -- B:jb
    jb:L --> R:cra
    jl:R --> L:api
    api:T --> B:gh{group}
    gh:R --> L:runners
    runners:R --> L:pages
    api:R -- L:ja
    ja:R -- L:jx
    jx:R --> L:py
    ja:B -- T:jd
    jd:B --> T:db
    jd:R --> L:aisrv
    py{group}:B --> T:aisrv
    py{group}:R -- L:jm
    jm:R --> L:groq
    jm:B --> T:ollama
    aisrv:R --> L:ollama
    aisrv{group}:B --> T:pg
