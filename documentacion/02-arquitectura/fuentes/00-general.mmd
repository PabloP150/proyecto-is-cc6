---
config:
  architecture:
    idealEdgeLengthMultiplier: 2
---
architecture-beta
    service fe(logos:react)[Navegador React 18 y MUI]
    junction j0
    junction j1
    junction j2
    junction ja
    junction js
    junction jm

    group api(logos:nodejs-icon)[API Express puerto 9000]
    service wss(logos:websocket)[WebSockets] in api
    service rest(mdi:api)[REST con JWT] in api
    service hook(mdi:source-pull)[Webhook GitHub HMAC SHA-256] in api
    service vhook(mdi:webhook)[Webhook Vercel HMAC SHA-1] in api

    group py(logos:python)[Servicio Python del chat]
    service orch(logos:fastapi-icon)[FastAPI y agentes] in py
    service groq(logos:groq)[Groq respaldo en la nube]

    group ial(mdi:robot-outline)[IA local]
    service ollama(logos:ollama)[Ollama con Gemma 4] in ial
    service aisrv(logos:fastapi-icon)[Servidor de IA local opcional] in ial
    service pg(logos:postgresql)[Postgres y pgvector] in ial

    group docker(logos:docker-icon)[Contenedor]
    service db(mdi:database)[SQL Server 2019 en Docker o Podman] in docker

    group github(logos:github-icon)[GitHub]
    service gh(logos:github-icon)[GitHub App] in github
    service gha(logos:github-actions)[GitHub Actions] in github
    service pages(mdi:web)[GitHub Pages] in github

    service smee(mdi:lan)[smee en desarrollo]
    service vercel(logos:vercel-icon)[Vercel]

    fe:R -- L:j0
    j0:T -- B:j1
    j0:B -- T:j2
    j1:R --> L:wss
    j2:R --> L:rest
    wss{group}:R --> L:orch
    orch:R -- L:jm
    jm:R --> L:ollama
    jm:B --> T:groq
    wss{group}:T -- B:ja
    ja:R -- L:js
    orch{group}:T -- B:js
    js:R --> T:aisrv
    aisrv:L --> R:ollama
    aisrv:R --> L:pg
    rest{group}:R --> L:gh
    gh:R --> L:gha
    gha:R --> L:pages
    gh{group}:B --> T:smee
    smee:L --> R:hook
    vercel:L --> R:vhook
    hook{group}:B --> T:db
