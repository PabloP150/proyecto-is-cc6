# TaskMate API — example configuration (placeholders only; never commit real values).
# Copy to taskmate-api/.env or to the repository root .env (both are loaded; the local one wins).

# --- API server --------------------------------------------------------------
API_PORT=9000
NODE_ENV=development
# Allowed browser origins, comma-separated. The first one is also where the GitHub
# callback redirects (FRONTEND_URL/github). WebSocket handshakes from other origins get 403.
FRONTEND_URL=http://localhost:3000
# Requests per window: login/registration (15 min, per IP) and general API (1 min, per user).
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=300
# Behind a reverse proxy: hop count ("1"), "true", or an Express trust list ("loopback, 10.0.0.0/8").
# Leave empty when the API is reached directly (rate limits then use the socket IP).
TRUST_PROXY=

# --- Auth ----------------------------------------------------------------------
# HS256 secret, at least 32 random characters (e.g. `openssl rand -base64 48`). The server refuses
# to start with a short or placeholder value like the one below. Also signs the GitHub install `state`.
JWT_SECRET=change-me-to-a-long-random-string

# --- SQL Server ---------------------------------------------------------------
DB_SERVER=localhost
DB_PORT=1433
DB_AUTH_TYPE=default
DB_USERNAME=sa
DB_PASSWORD=change-me
DB_NAME=TaskMate
DB_POOL_MAX=10
# DDL login for `npm run db:migrate` (migrations/runner.js). Required: the app login above is only
# db_datareader + db_datawriter. When unset the runner tries DB_USERNAME/DB_PASSWORD and DDL fails.
MIGRATION_DB_USERNAME=taskmate_migrator
MIGRATION_DB_PASSWORD=change-me
# Optional. Leave commented to auto-detect (encrypt off + trusted cert for localhost).
# DB_INSTANCE=
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERT=false

# --- Python AI service (taskmate-api/mcp) ------------------------------------
# Node connects here over WebSocket.
LLM_WEBSOCKET_URL=ws://127.0.0.1:8001/ws
# How long Node waits for that socket before answering the user with LLM_ERROR.
LLM_CONNECT_TIMEOUT_MS=5000
# Shared by Node and Python: sent by Node as the X-MCP-Secret header; Python answers 403 without it.
# Required. Use a long random value (e.g. `openssl rand -hex 32`).
MCP_SHARED_SECRET=change-me-to-a-long-random-string
# Read by the Python service:
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_LOG_LEVEL=INFO
MCP_SESSION_TTL_SEC=7200
MCP_MAX_SESSIONS=1000
# Seconds Python keeps a plan waiting for Node's save_plan_result before treating it as unsaved.
MCP_PENDING_SAVE_TTL_SEC=60
# Largest accepted frame from Node (bigger ones get MESSAGE_TOO_LONG).
MCP_MAX_MESSAGE_CHARS=1048576
# Tests only: lets Python accept connections without MCP_SHARED_SECRET. Never set in production.
# MCP_ALLOW_NO_SECRET=1
GROQ_API_KEY=your-groq-api-key
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SEC=60
LLM_MAX_RETRIES=2
# Repository analysis (feature 2). Node aborts a request after 90 s (LLM_TIMEOUT).
REPO_ANALYSIS_MODEL=llama-3.1-8b-instant
REPO_ANALYSIS_TIMEOUT_SEC=35
REPO_ANALYSIS_DEADLINE_SEC=80
REPO_ANALYSIS_QUEUE_TIMEOUT_SEC=20

# --- Analytics -----------------------------------------------------------------
ANALYTICS_ENABLED=true
ANALYTICS_BATCH_ENABLED=false
ANALYTICS_BATCH_SCHEDULE=0 2 * * *

# --- GitHub App (features 1, 2, 3, 5, 6) -------------------------------------
# From https://github.com/settings/apps/<your-app>. Required permissions: Contents (read & write),
# Metadata (read), Pull requests (read), Issues (read). Events: Pull request (installation and
# installation_repositories are always delivered). Enable "Request user authorization (OAuth)
# during installation" and set the Callback URL to <API>/api/github/callback.
GITHUB_APP_ID=123456
# URL slug of the App: https://github.com/apps/<slug>
GITHUB_APP_SLUG=your-app-slug
GITHUB_APP_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_APP_CLIENT_SECRET=your-client-secret
# Private key (.pem) encoded as base64 on one line: base64 -i key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY=base64-encoded-pem
# Same value as "Webhook secret" in the App settings. Webhooks are rejected while it is empty.
GITHUB_WEBHOOK_SECRET=your-webhook-secret
# Optional: only if the App has several callback URLs (must match one of them exactly).
GITHUB_APP_CALLBACK_URL=
# Requests per hour TaskMate allows itself per installation (GitHub's limit is 5000/h).
GITHUB_INSTALLATION_HOURLY_BUDGET=4000
# Development webhooks: npx smee-client --url https://smee.io/<channel> --target http://localhost:9000/api/github/webhook
