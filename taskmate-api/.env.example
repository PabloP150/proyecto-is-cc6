# TaskMate — example configuration (placeholders only; never commit real values).
#
# Copy it to the REPOSITORY ROOT and edit it there:   cp taskmate-api/.env.example .env
# The root .env is the only supported location. Who reads it:
#   - start.sh: API_PORT, MCP_PORT, LLM_WEBSOCKET_URL and MCP_SHARED_SECRET, only from the root .env.
#   - The API (server.js, helpers/pool.js, migrations/runner.js): first <current directory>/.env, then
#     the root .env without overriding. start.sh runs the API from the root, so only the root .env is
#     used. A taskmate-api/.env is read (and wins) only when a command runs from taskmate-api/
#     (`npm run start:api`, `npm run db:migrate`), which is why keeping one file avoids surprises.
#   - The AI server (mcp/llm_service.py): taskmate-api/mcp/.env, taskmate-api/.env and the root .env,
#     in that order. It loads every variable of the file into its environment, although it only reads
#     GROQ_API_KEY / LLM_*, MCP_*, REPO_ANALYSIS_* and PIPELINE_AGENT_*.
#   - The frontend (Create React App): REACT_APP_* from the root .env, when `npm start` or
#     `npm run build` starts.
# Variables already exported in the shell always win. Restart the API and the AI server after editing
# (and `npm start` for REACT_APP_* changes).
# Not read from here: the container settings (SA_PASSWORD, DB_PASSWORD… are `docker run -e` options,
# see documentacion/07-guias/base-de-datos-docker.md) and the DB test settings (TEST_DB_*, see the "Tests" section at the end).

# --- API server --------------------------------------------------------------
API_PORT=9000
# Allowed browser origins, comma-separated (default http://localhost:3000). The first one is also where
# the GitHub callback redirects (FRONTEND_URL/github). WebSocket handshakes from other origins get 403.
FRONTEND_URL=http://localhost:3000
# Requests per window: login/registration (15 min, per IP) and general API (1 min, per user).
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=300
# Behind a reverse proxy set the number of proxy hops (usually "1") or an Express trust list
# ("loopback, 10.0.0.0/8"). Avoid "true": it trusts any X-Forwarded-For, so clients can spoof their IP
# and dodge the IP-based limits. Leave empty when the API is reached directly.
TRUST_PROXY=
# NODE_ENV is not read by the app. Only NODE_ENV=integration-test matters: it enables the tests in
# tests/performance.test.js and tests/integration/ (npm run test:performance sets it).

# --- Auth ----------------------------------------------------------------------
# HS256 secret, at least 32 random characters (e.g. `openssl rand -base64 48`). The API refuses
# to start with a short or placeholder value like the one below. Also signs the GitHub install `state`.
JWT_SECRET=change-me-to-a-long-random-string

# --- SQL Server ---------------------------------------------------------------
DB_SERVER=localhost
DB_PORT=1433
DB_AUTH_TYPE=default
# App login created by setup-db.sh (db_datareader + db_datawriter only). Never run the API as `sa`.
# DB_PASSWORD must be the DB_PASSWORD given to `docker run` when the container was created.
DB_USERNAME=sqladmin
DB_PASSWORD=change-me
DB_NAME=taskmate-db
DB_POOL_MAX=10
# DDL login for `npm run db:migrate` and `node migrations/runner.js status|down|reapply`. Required
# because the app login above cannot change the schema. In the Docker dev setup this is the SA account
# (its password is the container's SA_PASSWORD); in production use a dedicated login with db_ddladmin.
# You may leave both out of this file and pass them on the command line when migrating.
MIGRATION_DB_USERNAME=sa
MIGRATION_DB_PASSWORD=change-me
# Optional. Leave commented to auto-detect (encrypt off + trusted cert for localhost).
# DB_INSTANCE=
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERT=false

# --- Python AI service (taskmate-api/mcp) ------------------------------------
# Node connects here over WebSocket. Its port must be MCP_PORT (start.sh warns when they differ).
LLM_WEBSOCKET_URL=ws://127.0.0.1:8001/ws
# How long Node waits for that socket before answering the user with LLM_ERROR.
LLM_CONNECT_TIMEOUT_MS=5000
# Shared by Node and Python: sent by Node as the X-MCP-Secret header; Python answers 403 without it.
# Required. At least 32 random characters (e.g. `openssl rand -hex 32`); Python refuses to start
# with a short or placeholder value.
MCP_SHARED_SECRET=change-me-to-a-long-random-string
# Port of the AI server (default 8001). start.sh passes it to uvicorn and always binds 127.0.0.1;
# if 8001 is taken, use another one (e.g. 8011) and change LLM_WEBSOCKET_URL to match.
# taskmate-api/start-mcp-server.sh ignores it (fixed 8001): start.sh is the supported launcher.
MCP_PORT=8001
# Only used when the server is started with `python server.py` (start.sh always uses 127.0.0.1).
MCP_HOST=127.0.0.1
MCP_LOG_LEVEL=INFO
MCP_SESSION_TTL_SEC=7200
MCP_MAX_SESSIONS=1000
# Seconds Python keeps a plan waiting for Node's save_plan_result before treating it as unsaved.
MCP_PENDING_SAVE_TTL_SEC=60
# Largest accepted frame from Node (bigger ones get MESSAGE_TOO_LONG).
MCP_MAX_MESSAGE_CHARS=1048576
# Tests only: lets Python accept connections without MCP_SHARED_SECRET. Never set in production.
# MCP_ALLOW_NO_SECRET=1

# Groq (https://console.groq.com/keys). LLM_API_KEY is accepted as an alias when GROQ_API_KEY is empty.
GROQ_API_KEY=your-groq-api-key
# LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Code default 0.7.
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SEC=60
LLM_MAX_RETRIES=2
# max_tokens for chat replies and for project plans.
LLM_MAX_TOKENS_CHAT=1000
LLM_MAX_TOKENS_PLAN=8192
# Reasoning effort for openai/gpt-oss models (low | medium | high): reasoning counts against max_tokens and the Groq quota.
LLM_REASONING_EFFORT=low

# Repository analysis (Phase 3: the AI proposes tasks from the repo). Node gives up after 90 s (LLM_TIMEOUT).
# REPO_ANALYSIS_MODEL defaults to LLM_MODEL.
REPO_ANALYSIS_MODEL=openai/gpt-oss-20b
REPO_ANALYSIS_TIMEOUT_SEC=35
REPO_ANALYSIS_DEADLINE_SEC=80
REPO_ANALYSIS_QUEUE_TIMEOUT_SEC=20

# Pipeline proposal (Phase 4: the AI proposes the CI/CD pipeline). Node gives up after 60 s, so the
# deadline must stay below that. Per-call timeout is capped at 30 s.
PIPELINE_AGENT_TIMEOUT_SEC=25
PIPELINE_AGENT_DEADLINE_SEC=50
PIPELINE_AGENT_QUEUE_TIMEOUT_SEC=15

# --- Analytics -----------------------------------------------------------------
# Records task assignments and completions (anything but "false" means enabled).
ANALYTICS_ENABLED=true
# Periodic recompute of the metrics (node-cron), off by default.
ANALYTICS_BATCH_ENABLED=false
ANALYTICS_BATCH_SCHEDULE=0 2 * * *
# Time zone of that schedule (default UTC). TZ is the standard process-wide time zone variable, so it
# also affects any other local-time handling in the processes that load this file.
# TZ=UTC

# --- GitHub App (Phases 3 and 4) ------------------------------------------------
# Step by step: documentacion/07-guias/guia-github-app.md (sections 4-6).
# Without these variables the GitHub routes answer 503 GITHUB_NOT_CONFIGURED; the rest of TaskMate works.
#
# App settings at https://github.com/settings/apps/<your-app>:
#   - Callback URL: <API>/api/github/callback (http://localhost:9000/api/github/callback in development).
#   - Request user authorization (OAuth) during installation: checked (required).
#   - Redirect on update: checked (since Phase 4).
#   - Webhook: active; URL = your smee.io channel in development; secret = GITHUB_WEBHOOK_SECRET.
#   - Repository permissions (everything else: No access):
#       Phase 3: Contents read & write, Metadata read-only, Pull requests read-only, Issues read-only.
#       Phase 4: Actions read & write, Administration read & write (only to enable GitHub Pages),
#                Checks read-only, Deployments read-only, Pages read & write, Workflows read & write.
#   - Subscribe to events: Pull request, Workflow run, Workflow job, Deployment status
#     (installation and installation_repositories are always delivered).
# Existing installations must accept new permissions on GitHub before the Phase 4 actions work
# (until then they answer APP_PERMISSIONS_MISSING).
GITHUB_APP_ID=123456
# URL slug of the App: https://github.com/apps/<slug>
GITHUB_APP_SLUG=your-app-slug
GITHUB_APP_CLIENT_ID=your-client-id
GITHUB_APP_CLIENT_SECRET=your-client-secret
# Private key (.pem) encoded as base64 on one line: base64 -i key.pem | tr -d '\n'  (Linux: base64 -w0 key.pem)
GITHUB_APP_PRIVATE_KEY=base64-encoded-pem
# Same value as "Webhook secret" in the App settings (e.g. `openssl rand -hex 32`). Webhooks are
# rejected (401) while it is empty or different.
GITHUB_WEBHOOK_SECRET=your-webhook-secret
# Days to keep webhook delivery records (they are the replay protection). Minimum 30, default 90.
WEBHOOK_DELIVERY_RETENTION_DAYS=90
# Optional: only if the App has several callback URLs (must match one of them exactly).
GITHUB_APP_CALLBACK_URL=
# Requests per hour TaskMate allows itself per installation (GitHub's limit is 5000/h).
GITHUB_INSTALLATION_HOURLY_BUDGET=4000
# Development webhooks (start.sh does not run it; use another terminal):
#   npx smee-client --url https://smee.io/<channel> --target http://localhost:9000/api/github/webhook

# --- Frontend (Create React App, root .env only) --------------------------------
# Only needed if the API is not on http://localhost:9000.
# REACT_APP_API_URL=http://localhost:9000
# REACT_APP_WS_URL=ws://localhost:9000

# --- Tests -------------------------------------------------------------------
# `npm run test:db` never takes its connection from this file (TEST_DB_* written here are ignored).
# It connects only through TEST_DB_SERVER, TEST_DB_PORT, TEST_DB_NAME, TEST_DB_USERNAME, TEST_DB_PASSWORD
# and TEST_DB_SA_PASSWORD (or TEST_DB_MIGRATION_USERNAME / TEST_DB_MIGRATION_PASSWORD), exported in the
# shell or kept in a file outside the repository passed as TEST_DB_ENV_FILE.
# Always a disposable SQL Server, never the dev container: documentacion/07-guias/base-de-datos-docker.md section 6.
